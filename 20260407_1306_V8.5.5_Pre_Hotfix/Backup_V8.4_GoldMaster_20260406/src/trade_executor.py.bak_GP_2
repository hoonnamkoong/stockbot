"""
[Grand Protocol v2] trade_executor.py
========================================
예약 주문(Reservations)을 검토하고 실행합니다.

강화 사항:
1. 환경 변수 사전 검증 (KIS 관련 필수 값 누락 시 명확한 에러 출력)
2. place_order import 실패 시 sys.exit() 대신 그레이스풀 종료
3. 실행된 주문을 data/order_history.json 에 영구 기록
4. 각 예약 주문 처리가 독립 try-except 로 격리
5. API 키/시크릿 값은 절대 로그에 출력하지 않음
"""
import json
import os
import sys
from datetime import datetime, timezone

# ─── 경로 설정 ───────────────────────────────────────────────────────────────
# 이 파일: src/trade_executor.py  → trade/ 는 상위 폴더에 있음
_REPO_ROOT = os.path.abspath(os.path.join(os.path.dirname(__file__), '..'))
_TRADE_DIR = os.path.join(_REPO_ROOT, 'trade')

# sys.path 중복 추가 방지
if _TRADE_DIR not in sys.path:
    sys.path.insert(0, _TRADE_DIR)
if _REPO_ROOT not in sys.path:
    sys.path.insert(0, _REPO_ROOT)

# ─── 환경 변수 검증 ──────────────────────────────────────────────────────────

def _validate_trade_env() -> bool:
    """
    KIS 트레이딩에 필요한 환경 변수를 검증합니다.
    누락된 변수가 있으면 False 를 반환합니다.
    [보안] 실제 값(키/시크릿 문자열)은 절대 출력하지 않습니다.
    """
    required = {
        'KIS_APP_KEY':    'KIS 앱 키',
        'KIS_APP_SECRET': 'KIS 앱 시크릿',
        'KIS_ACCOUNT_NO': 'KIS 계좌번호',
        'KIS_BASE_URL':   'KIS API Base URL',
    }
    missing = []
    for key, desc in required.items():
        val = os.environ.get(key, '').strip()
        if not val:
            missing.append(f"  ❌ 누락: {desc} (변수명={key})")
        else:
            # 키 값 노출 없이 존재 여부만 출력
            print(f"  ✅ {desc} (변수명={key}, 길이={len(val)}자)")

    if missing:
        print("[TradeExecutor] ⚠️  필수 환경 변수 누락:")
        for m in missing:
            print(m)
        return False

    print("[TradeExecutor] 환경 변수 검증 통과.")
    return True


# ─── place_order 임포트 ───────────────────────────────────────────────────────

try:
    from order import place_order
    _ORDER_AVAILABLE = True
except ImportError as _e:
    print(f"[TradeExecutor] ⚠️  place_order 임포트 실패: {_e}")
    print("[TradeExecutor] trade/order.py 를 찾을 수 없습니다. 주문 실행이 비활성화됩니다.")
    _ORDER_AVAILABLE = False

    # 더미 함수: 임포트 실패 시 호출해도 크래시 없이 에러만 출력
    def place_order(side, code, qty, price):
        raise RuntimeError("place_order 모듈을 불러올 수 없음 (ImportError). 주문 불가.")


# ─── 파일 경로 상수 ───────────────────────────────────────────────────────────

RESERVATIONS_FILE  = os.path.join(_REPO_ROOT, 'data', 'reservations.json')
ORDER_HISTORY_FILE = os.path.join(_REPO_ROOT, 'data', 'order_history.json')


# ─── 유틸리티 ────────────────────────────────────────────────────────────────

def _load_json_file(filepath: str, default):
    """JSON 파일을 안전하게 읽습니다. 파일 없거나 파싱 실패 시 default 반환."""
    if not os.path.exists(filepath):
        return default
    try:
        with open(filepath, 'r', encoding='utf-8') as f:
            return json.load(f)
    except Exception as e:
        print(f"[TradeExecutor] ❌ JSON 읽기 실패 ({os.path.basename(filepath)}): {e}")
        return default


def _save_json_file(filepath: str, data) -> bool:
    """JSON 파일을 안전하게 씁니다."""
    try:
        os.makedirs(os.path.dirname(filepath), exist_ok=True)
        with open(filepath, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        return True
    except Exception as e:
        print(f"[TradeExecutor] ❌ JSON 저장 실패 ({os.path.basename(filepath)}): {e}")
        return False


def load_reservations() -> list:
    data = _load_json_file(RESERVATIONS_FILE, [])
    if not isinstance(data, list):
        print("[TradeExecutor] ⚠️  reservations.json 형식 오류 (리스트 아님). 빈 목록으로 초기화.")
        return []
    return data


def save_reservations(reservations: list) -> None:
    if _save_json_file(RESERVATIONS_FILE, reservations):
        print(f"[TradeExecutor] reservations.json 업데이트 완료. 잔여 예약: {len(reservations)}건")


def append_order_history(record: dict) -> None:
    """
    실행된 주문을 data/order_history.json 에 영구 기록합니다.
    기록 실패해도 주문 자체는 영향 없습니다.
    """
    history = _load_json_file(ORDER_HISTORY_FILE, [])
    if not isinstance(history, list):
        history = []
    history.insert(0, record)  # 최신 기록을 맨 앞에
    if _save_json_file(ORDER_HISTORY_FILE, history):
        print(f"[TradeExecutor] 주문 이력 저장 완료 → {os.path.basename(ORDER_HISTORY_FILE)}: {len(history)}건 누적")
    else:
        print(f"[TradeExecutor] ⚠️  주문 이력 저장 실패. 주문 자체는 정상 처리됨.")


# ─── 메인 로직 ───────────────────────────────────────────────────────────────

def main():
    now_utc = datetime.now(timezone.utc)
    print(f"\n[TradeExecutor] 시작 — {now_utc.strftime('%Y-%m-%d %H:%M:%S')} UTC")

    # 1. 환경 변수 사전 검증
    env_ok = _validate_trade_env()
    if not env_ok:
        print("[TradeExecutor] 필수 환경 변수 누락으로 실행을 건너뜁니다.")
        sys.exit(0)  # sys.exit(1) 이 아닌 0으로 종료 → GitHub Actions 스텝 실패 방지

    # 2. place_order 사용 가능 여부 확인
    if not _ORDER_AVAILABLE:
        print("[TradeExecutor] place_order 미사용 가능. 주문 실행 없이 종료합니다.")
        sys.exit(0)

    # 3. 예약 목록 로드
    reservations = load_reservations()
    if not reservations:
        print("[TradeExecutor] 실행할 예약 주문이 없습니다.")
        sys.exit(0)

    print(f"[TradeExecutor] 총 {len(reservations)}건의 예약 확인 중...")

    pending_reservations = []   # 아직 시간이 안 된 예약
    executed_count = 0
    failed_count = 0

    for res in reservations:
        res_id = res.get('id', 'unknown')

        # ── 각 예약을 독립 try-except 로 처리 ──────────────────────────────
        try:
            target_time_str = res.get('targetTime', '').strip()
            if not target_time_str:
                print(f"  [Skip] 예약 {res_id}: targetTime 없음. 보류 목록에 유지.")
                pending_reservations.append(res)
                continue

            # Z suffix 처리 (Python 3.10 이하 호환)
            if target_time_str.endswith('Z'):
                target_time_str = target_time_str[:-1] + '+00:00'

            target_time = datetime.fromisoformat(target_time_str)
            if target_time.tzinfo is None:
                target_time = target_time.replace(tzinfo=timezone.utc)

            status = res.get('status', 'pending')

            if status == 'executed':
                # 이미 실행된 항목은 조용히 제거
                print(f"  [Skip] 예약 {res_id}: 이미 실행됨.")
                continue

            if now_utc < target_time:
                # 아직 실행 시간이 아님
                print(f"  [Wait] 예약 {res_id}: {target_time.strftime('%m-%d %H:%M')} UTC 대기 중.")
                pending_reservations.append(res)
                continue

            # ── 실행 시간 도달 → 주문 실행 ─────────────────────────────────
            code  = res.get('code', '')
            side  = res.get('side', 'buy')
            qty   = int(res.get('qty', 1))
            price = int(res.get('price', 0))

            print(f"  [Execute] 예약 {res_id}: {side.upper()} {code} {qty}주 @ {price}원")

            place_order(side=side, code=code, qty=qty, price=price)

            # 실행 성공 → 이력 기록
            history_record = {
                'id':          res_id,
                'executed_at': now_utc.isoformat(),
                'side':        side,
                'code':        code,
                'qty':         qty,
                'price':       price,
                'original_target_time': res.get('targetTime'),
                'status':      'executed',
            }
            append_order_history(history_record)

            print(f"  [Success] 예약 {res_id} 실행 완료. 이력 기록됨.")
            executed_count += 1
            # pending 에 추가하지 않음 → 예약 목록에서 제거됨

        except Exception as e:
            failed_count += 1
            print(f"  [Error] 예약 {res_id} 처리 중 예외: {type(e).__name__}: {e}")
            # 실패한 예약은 보류 목록에 유지 (재시도 가능)
            pending_reservations.append(res)

    # 4. 결과 저장
    print(f"\n[TradeExecutor] 결과: 실행={executed_count}건, 실패={failed_count}건, 대기={len(pending_reservations)}건")

    if executed_count > 0 or failed_count > 0:
        save_reservations(pending_reservations)
    else:
        print("[TradeExecutor] 변경 사항 없음 — reservations.json 유지.")


if __name__ == "__main__":
    main()
