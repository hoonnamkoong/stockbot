"""
[Grand Protocol] NotificationService
======================================
알림 전송의 유일한 진입점(Single Entry Point) 모듈입니다.

설계 원칙:
- scraper.py 는 이 클래스만 호출합니다. TelegramManager를 직접 임포트하지 않습니다.
- 메시지 전송은 각각 독립된 try-except 블록으로 격리합니다.
  → 하나가 실패해도 나머지 메시지는 계속 전송됩니다.
- 이 모듈에서 발생한 에러는 scraper.py 의 스크래핑 로직에 영향을 주지 않습니다.
- 시크릿 값은 로그에 출력하지 않습니다.
"""
import os
import sys
import traceback

# telegram_manager는 이 모듈 내부에서만 사용합니다.
try:
    sys.path.insert(0, os.path.abspath(os.path.join(os.path.dirname(__file__), '..')))
    from telegram_manager import TelegramManager
    _TG_AVAILABLE = True
except ImportError:
    _TG_AVAILABLE = False


# ─── 내부 헬퍼 ───────────────────────────────────────────────────────────────

def _safe_send(tg: 'TelegramManager', message: str, label: str = "") -> bool:
    """
    단일 메시지를 안전하게 전송합니다.
    실패해도 예외를 상위로 전파하지 않고 False를 반환합니다.
    """
    try:
        result = tg.send_message(message)
        if label:
            print(f"[NotificationService] ✅ 전송 성공: {label}")
        return result
    except Exception as e:
        if label:
            print(f"[NotificationService] ❌ 전송 실패: {label} — {type(e).__name__}: {e}")
        return False


# ─── 메인 클래스 ─────────────────────────────────────────────────────────────

class NotificationService:
    """
    텔레그램 알림 전송의 유일한 진입점.
    scraper.py 는 이 클래스만 사용합니다.
    """

    def __init__(self):
        self._tg = None
        self._available = False
        self._init_telegram()

    def _init_telegram(self):
        """TelegramManager를 초기화합니다. 실패해도 시스템이 다운되지 않습니다."""
        if not _TG_AVAILABLE:
            print("[NotificationService] ⚠️  TelegramManager 임포트 실패. 알림 비활성화.")
            return

        token = os.environ.get('TELEGRAM_BOT_TOKEN', '').strip()
        chat_id = os.environ.get('TELEGRAM_CHAT_ID', '').strip()

        if not token or not chat_id:
            print("[NotificationService] ⚠️  TELEGRAM_BOT_TOKEN 또는 TELEGRAM_CHAT_ID 누락. 알림 비활성화.")
            return

        try:
            self._tg = TelegramManager()
            self._available = True
            print("[NotificationService] ✅ TelegramManager 초기화 성공.")
        except Exception as e:
            print(f"[NotificationService] ❌ TelegramManager 초기화 실패: {type(e).__name__}: {e}")

    @property
    def is_available(self) -> bool:
        return self._available and self._tg is not None

    # ─── 공개 메서드 ───────────────────────────────────────────────────────────

    def send_hourly_report(
        self,
        kospi_records: list,
        kosdaq_records: list,
        advisor_report_text: str = "",
        dashboard_url: str = "",
    ) -> None:
        """
        정시 리포트(KOSPI + KOSDAQ + 전략 가이드 + 대시보드 링크)를 순차 전송합니다.
        각 블록이 독립적으로 전송되므로, 하나가 실패해도 나머지는 계속 전송됩니다.
        """
        if not self.is_available:
            print("[NotificationService] 알림 비활성화 상태 — 전송 건너뜀.")
            return

        # 1. KOSPI 리포트
        try:
            if kospi_records:
                msg = self._build_market_report("KOSPI", kospi_records)
                _safe_send(self._tg, msg, label="KOSPI 리포트")
        except Exception as e:
            print(f"[NotificationService] ❌ KOSPI 리포트 빌드 실패: {e}")

        # 2. KOSDAQ 리포트
        try:
            if kosdaq_records:
                msg = self._build_market_report("KOSDAQ", kosdaq_records)
                _safe_send(self._tg, msg, label="KOSDAQ 리포트")
        except Exception as e:
            print(f"[NotificationService] ❌ KOSDAQ 리포트 빌드 실패: {e}")

        # 3. 전략 가이드 (Gemini 생성)
        try:
            if advisor_report_text:
                # 메시지 길이 제한 처리 (Telegram 4096자)
                MAX_LEN = 3500
                if len(advisor_report_text) > MAX_LEN:
                    parts = [
                        advisor_report_text[i:i + MAX_LEN]
                        for i in range(0, len(advisor_report_text), MAX_LEN)
                    ]
                    for idx, part in enumerate(parts):
                        _safe_send(
                            self._tg,
                            f"🧠 <b>[Strategic Guide {idx + 1}/{len(parts)}]</b>\n{part}",
                            label=f"전략 가이드 파트{idx + 1}",
                        )
                else:
                    _safe_send(
                        self._tg,
                        f"🧠 <b>[Strategic Guide]</b>\n{advisor_report_text}",
                        label="전략 가이드",
                    )
        except Exception as e:
            print(f"[NotificationService] ❌ 전략 가이드 전송 실패: {e}")

        # 4. 대시보드 링크
        try:
            url = dashboard_url or os.environ.get('DASHBOARD_URL', 'https://stockbot-phi.vercel.app')
            _safe_send(
                self._tg,
                f"👉 <b>Dashboard</b>: {url}",
                label="대시보드 링크",
            )
        except Exception as e:
            print(f"[NotificationService] ❌ 대시보드 링크 전송 실패: {e}")

    def send_no_data_alert(self, threshold: int) -> None:
        """기준치 미달로 수집된 종목이 없을 때 알림을 전송합니다."""
        if not self.is_available:
            return
        try:
            import time
            timestamp = time.strftime('%H:%M')
            msg = (
                f"📉 <b>[Report] {timestamp}</b>\n"
                f"Threshold: {threshold} posts\n"
                f"ℹ️ 조건에 맞는 급상승 종목이 없습니다."
            )
            _safe_send(self._tg, msg, label="데이터 없음 알림")
        except Exception as e:
            print(f"[NotificationService] ❌ 데이터 없음 알림 실패: {e}")

    def send_error_alert(self, error_msg: str) -> None:
        """시스템 에러를 텔레그램으로 전송합니다. 키/토큰은 마스킹됩니다."""
        if not self.is_available:
            print(f"[NotificationService] 에러 알림 전송 불가 (비활성화): {error_msg}")
            return
        try:
            from src.config_validator import mask_sensitive
            safe_msg = mask_sensitive(str(error_msg))
        except ImportError:
            safe_msg = str(error_msg)[:200]  # 마스킹 불가시 잘라서 전송

        try:
            _safe_send(
                self._tg,
                f"⚠️ <b>[System Error]</b>\n{safe_msg}",
                label="에러 알림",
            )
        except Exception as e:
            print(f"[NotificationService] ❌ 에러 알림 전송 실패: {e}")

    # ─── 내부 빌더 ─────────────────────────────────────────────────────────────

    @staticmethod
    def _build_market_report(market: str, records: list) -> str:
        """
        market: 'KOSPI' or 'KOSDAQ'
        records: result_df_kr.to_dict('records') 결과 리스트
        """
        icon = "📉" if market == "KOSPI" else "📈"
        top5 = records[:5]
        msg = f"{icon} <b>[{market}] Top {min(len(top5), 5)} (토론 급등)</b>\n\n"

        for item in top5:
            name = item.get('종목명', item.get('name', '?'))
            try:
                price = f"{int(item.get('현재가', item.get('price', 0))):,}"
            except (ValueError, TypeError):
                price = str(item.get('현재가', item.get('price', '?')))

            change = item.get('등락률', item.get('change_rate', '?'))
            posts = item.get('당일_게시글수', item.get('recent_posts_count', '?'))
            summary = item.get('게시물_요약', item.get('posts_summary', '요약 없음'))

            if isinstance(summary, str) and len(summary) > 100:
                summary = summary[:100] + "..."

            msg += f"🔥 <b>{name}</b> ({price}원 | {change})\n"
            msg += f"💬 {posts}개 의견\n"
            msg += f"📝 {summary}\n\n"

        if len(records) > 5:
            msg += f"<i>... 외 {len(records) - 5}개 종목 — Dashboard 확인</i>\n"

        return msg
